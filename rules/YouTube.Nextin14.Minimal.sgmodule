#!name=YouTube Nextin 1.4 Minimal
#!desc=Nextin 1.4 专用精简版：尽量只处理视频播放相关接口，目标为去视频广告 + 后台播放；不碰首页 browse/search/guide/config/log_event 响应，降低二次启动白屏/加载失败概率。
#!author=OpenAI adaptation based on Maasea
#!version=2026.10.05-nx1

[Rule]
# 禁用 QUIC/UDP，避免 googlevideo 绕过 HTTPS Rewrite
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
# 只改播放相关响应：player/get_watch/next
YouTube.Nextin14.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch|next)(\?.*)?$,requires-body=true,binary-body-mode=true,max-size=10485760,timeout=10,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js,argument="{\"captionLang\":\"off\",\"blockUpload\":false,\"blockImmersive\":false,\"blockShorts\":false,\"debug\":false}"

# 新版加密播放链路只保留 initplayback 请求处理；不处理 log_event/config，避免干扰应用启动阶段
YouTube.Nextin14.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=true,binary-body-mode=true,max-size=10485760,timeout=10,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js,argument="{\"captionLang\":\"off\"}"

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com
