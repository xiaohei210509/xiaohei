#!name=YouTube Nextin 1.4 Minimal v2
#!desc=Nextin 1.4 专用：只保留播放去广告/后台播放所需接口，并保留新版 encrypted initplayback 所依赖的 key 同步；不处理 browse/search/guide/reel 等首页接口。
#!author=OpenAI adaptation based on Maasea
#!version=2026.10.05-nx2

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Script]
# player/get_watch: 去视频广告 + 开启 PIP/后台播放能力
# account/get_setting: 显示后台播放设置
# config/log_event: 只用于保存新版 Onesie/initplayback 加密链路需要的 key；脚本不会改写其响应 body
YouTube.Nextin14.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch|account\/get_setting|config|log_event)(\?.*)?$,requires-body=true,binary-body-mode=true,max-size=10485760,timeout=10,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.response.js

# 新版 YouTube 加密播放链路：必须和 config/log_event 的 key 状态配套
YouTube.Nextin14.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=true,binary-body-mode=true,max-size=10485760,timeout=10,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js

# log_event 请求需要去掉 content-encoding/hot-hash，才能让响应脚本正确读取并保存 Onesie key
YouTube.Nextin14.logevent = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(\?.*)?$,requires-body=true,binary-body-mode=true,max-size=10485760,timeout=10,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/65075cdb388fc5e3094afd7e7314c67b243f3525/Script/Youtube/youtube.request.js

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com
