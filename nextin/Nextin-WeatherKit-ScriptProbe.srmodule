#!name = WeatherKit Script Probe (Nextin)
#!desc = Diagnostic only. No rewrite and no body modification. Shows a notification whenever a WeatherKit API response script is triggered.

[Script]
weatherkit.script.probe = type=http-response,pattern=^https?:\/\/weatherkit\.apple\.com\/api\/.*$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/xiaohei210509/xiaohei/main/nextin/WeatherKit.ScriptProbe.Nextin.js

[MITM]
hostname = weatherkit.apple.com
